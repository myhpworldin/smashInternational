# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string — Cluster → Connect → Drivers.
# Include the database name in the path (…mongodb.net/yourDbName?…);
# that's the database notify signups are written to.
MONGODB_URI=

# Signs session cookies for admin/client login. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional — no email provider is required for local development. Without
# these, OTP emails are logged to the server console instead of sent (see
# src/lib/email/sendEmail.ts). Set both to send real email via Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary — Dashboard → Settings → API Keys. Use a SMASH-specific
# Cloudinary account/sub-account, not credentials shared with another
# project. Server-only (see src/server/storage/cloudinary.ts) — never
# exposed to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
