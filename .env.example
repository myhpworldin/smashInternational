# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string — Cluster → Connect → Drivers.
# Include the database name in the path (…mongodb.net/yourDbName?…);
# that's the database notify signups are written to.
MONGODB_URI=

# Signs session cookies for admin/client login. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
